#!/bin/sh
# Refuses a push whose commits carry a local path or private text in a message or a changed file
# (AGENTS.md, hard rules 1 and 4). A later commit does not unpublish an earlier one, so every commit in
# the push is checked, not only the last.
. "$(git rev-parse --show-toplevel)/tools/githooks/_python.sh"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue  # a deletion publishes nothing
  if [ "$remote_sha" = "$zero" ]; then
    base="$(git rev-parse -q --verify origin/main || git rev-parse -q --verify main)"
  else
    base="$remote_sha"
  fi
  [ -z "$base" ] && continue
  run_check --commits "$base..$local_sha" || status=1
  run_tool check_private.py --commits "$base..$local_sha" || status=1
done
exit $status
